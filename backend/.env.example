# PostgreSQL connection (change user, password and port to match your install)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pdf_reports?schema=public
# API port
PORT=4000
# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000
# Maximum upload size in MB
MAX_UPLOAD_MB=10
# Folder where uploaded PDFs are stored
STORAGE_DIR=./storage
# Folder with the bundled Tesseract language model (eng.traineddata)
TESSDATA_DIR=./tessdata
# Resolution used to render scanned pages for OCR
OCR_DPI=300
